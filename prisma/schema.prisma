datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id                String          @id @default(uuid())
  organizationId    String          @unique
  name              String
  type              OrgType
  timezone          String          @default("UTC")
  attendancePolicy  AttendPolicy    @default(AUTO_ABSENT)
  routeSettings     Json // Optimized path parameters
  notifySettings    Json // Carriers setups (SMS, Push)
  operatingSchedule Json // Peak operating hours boundaries
  status            OrgStatus       @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  users             User[]
  vehicles          Vehicle[]
  routes            Route[]
  auditLogs         AuditLog[]
  incidents         Incident[]
  dataPurgeLogs     DataPurgeLog[]
  students          Student[]
  parentChildren    ParentChild[]
  driverLicenses    DriverLicense[]
  studentStops      StudentStop[]
  emergencies       Emergency[]

  @@index([organizationId])
}

enum OrgType {
  SCHOOL
  COLLEGE
  UNIVERSITY
  OTHER
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AttendPolicy {
  AUTO_PRESENT
  AUTO_ABSENT
}

model User {
  id                  String                   @id @default(uuid())
  organizationId      String
  email               String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole
  status              UserStatus               @default(ACTIVE)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  driverLicense       DriverLicense?
  parentChildren      ParentChild[]
  deviceSessions      DeviceSession[]
  trips               Trip[]
  notifyPrefs         UserNotificationPreference[]
  resolvedIncidents   Incident[]               @relation("IncidentResolver")
  privacyExports      PrivacyExport[]
  auditLogs           AuditLog[]
  notifications       NotificationRecipient[]
  reportedEmergencies Emergency[]              @relation("EmergencyReporter")
  emergencyHistories  EmergencyHistory[]

  @@unique([id, organizationId])
  @@index([organizationId, email])
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  OPERATOR
  DRIVER
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model ParentChild {
  id               String       @id @default(uuid())
  organizationId   String
  parentId         String
  studentId        String
  relationshipType String
  createdAt        DateTime     @default(now())
  organization     Organization @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  parent           User         @relation(fields: [parentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  student          Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Student {
  id              String            @id @default(uuid())
  organizationId  String
  studentNumber   String
  firstName       String
  lastName        String
  grade           String?
  status          StudentStatus     @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  parentChildren  ParentChild[]
  stopAssignments StudentStop[]
  attendanceLogs  DailyAttendance[]
  privacyExports  PrivacyExport[]

  @@unique([id, organizationId])
  @@unique([organizationId, studentNumber])
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model DriverLicense {
  id             String       @id @default(uuid())
  organizationId String
  userId         String       @unique
  licenseNumber  String       @unique
  expiryDate     DateTime
  licenseClass   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  user           User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Vehicle {
  id             String        @id @default(uuid())
  organizationId String
  registrationNo String        @unique
  capacity       Int
  status         VehicleStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  trips          Trip[]

  @@unique([id, organizationId])
  @@index([organizationId, registrationNo])
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Route {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  version        Int          @default(1)
  status         RouteStatus  @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  stops          Stop[]
  schedules      Schedule[]
  trips          Trip[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

model Stop {
  id             String        @id @default(uuid())
  organizationId String
  routeId        String
  name           String
  latitude       Float
  longitude      Float
  sequenceOrder  Int
  route          Route         @relation(fields: [routeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  students       StudentStop[]

  @@unique([id, organizationId])
  @@index([routeId, sequenceOrder])
}

model StudentStop {
  id             String       @id @default(uuid())
  organizationId String
  studentId      String
  stopId         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  student        Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  stop           Stop         @relation(fields: [stopId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([studentId, stopId])
}

model Schedule {
  id             String            @id @default(uuid())
  organizationId String
  routeId        String
  name           String
  cutoffTime     String
  operatingDays  Int[]
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  route          Route             @relation(fields: [routeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  attendanceLogs DailyAttendance[]
  trips          Trip[]

  @@unique([id, organizationId])
  @@index([routeId])
}

model DailyAttendance {
  id             String           @id @default(uuid())
  organizationId String
  scheduleId     String
  studentId      String
  date           String
  status         AttendanceStatus @default(PENDING)
  isLocked       Boolean          @default(false)
  updatedBy      String?
  updatedAt      DateTime         @updatedAt
  schedule       Schedule         @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  student        Student          @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([scheduleId, studentId, date])
  @@index([date, status])
}

enum AttendanceStatus {
  PENDING
  PRESENT
  ABSENT
}

model Trip {
  id             String               @id @default(uuid())
  organizationId String
  scheduleId     String
  routeId        String
  serviceDate    String
  vehicleId      String
  driverId       String
  status         TripStatus           @default(SCHEDULED)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  schedule       Schedule             @relation(fields: [scheduleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  route          Route                @relation(fields: [routeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vehicle        Vehicle              @relation(fields: [vehicleId, organizationId], references: [id, organizationId], onDelete: Restrict)
  driver         User                 @relation(fields: [driverId, organizationId], references: [id, organizationId], onDelete: Restrict)
  pings          TripPing[]
  notifications  Notification[]
  incidents      Incident[]
  emergencies    Emergency[]

  @@unique([id, organizationId])
  @@index([status, driverId])
}

enum TripStatus {
  SCHEDULED
  STARTED
  EN_ROUTE
  AT_STOP
  ATTENDANCE_OPEN
  ATTENDANCE_CLOSED
  ROUTE_OPTIMIZED
  READY
  ACTIVE
  COMPLETED
  CANCELLED
  EMERGENCY
}

model TripPing {
  id                String   @id @default(uuid())
  organizationId    String
  tripId            String
  latitude          Float
  longitude         Float
  accuracy          Float    @default(1.0)
  speed             Float
  heading           Float?
  sequence          Int
  timestamp         DateTime @default(now())
  receivedTimestamp DateTime @default(now())
  trip              Trip     @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: Cascade)
  emergencies       Emergency[]

  @@index([tripId, timestamp])
}

model Incident {
  id              String         @id @default(uuid())
  tripId          String
  organizationId  String
  status          IncidentStatus @default(ACTIVE)
  latitude        Float
  longitude       Float
  reason          String
  resolvedById    String?
  resolutionNotes String?
  resolvedAt      DateTime?
  idempotencyKey  String
  createdAt       DateTime       @default(now())
  trip            Trip           @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization    Organization   @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  resolvedBy      User?          @relation("IncidentResolver", fields: [resolvedById, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
}

enum IncidentStatus {
  ACTIVE
  RESOLVED
}

model UserNotificationPreference {
  id                String   @id @default(uuid())
  organizationId    String
  userId            String   @unique
  smsEnabled        Boolean  @default(true)
  pushEnabled       Boolean  @default(true)
  emailEnabled      Boolean  @default(false)
  inAppEnabled      Boolean  @default(true)
  quietHoursStart   String?  // e.g. "22:00"
  quietHoursEnd     String?  // e.g. "06:00"
  timezone          String   @default("UTC")
  language          String   @default("en")
  emergencyOverride Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model NotificationTemplate {
  id             String   @id @default(uuid())
  organizationId String
  eventKey       String   // e.g., "trip.started"
  channel        String   // IN_APP, EMAIL, SMS, PUSH
  language       String   @default("en")
  subject        String?
  body           String   // Content with placeholders
  version        Int      @default(1)
  isActive       Boolean  @default(true)
  auditFields    Json?    // e.g. { createdBy: "userId" }
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, eventKey, channel, language, version])
  @@index([organizationId, eventKey, isActive])
}

model Notification {
  id             String       @id @default(uuid())
  organizationId String
  correlationId  String?      // for tracking across distributed systems
  tripId         String?
  eventKey       String
  priority       String       // EMERGENCY, HIGH, NORMAL, LOW
  payload        Json         // the raw data
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  
  trip           Trip?        @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: SetNull)
  recipients     NotificationRecipient[]
}

model NotificationRecipient {
  id               String       @id @default(uuid())
  organizationId   String
  notificationId   String
  userId           String
  channel          String       // IN_APP, EMAIL, SMS, PUSH
  status           NotificationDeliveryStatus @default(QUEUED)
  retryCount       Int          @default(0)
  errorMessage     String?
  queuedAt         DateTime     @default(now())
  processingAt     DateTime?
  sentAt           DateTime?
  deliveredAt      DateTime?
  readAt           DateTime?
  failedAt         DateTime?
  expiredAt        DateTime?
  idempotencyKey   String?      @unique
  
  notification     Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  
  @@index([organizationId, status])
  @@index([userId, status])
}

enum NotificationDeliveryStatus {
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  EXPIRED
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  action         String
  metadata       Json
  ipAddress      String
  timestamp      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  user           User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
}

model DeviceSession {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  tokenHash      String   @unique
  deviceType     String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
}

model PrivacyExport {
  id             String       @id @default(uuid())
  organizationId String
  parentId       String
  studentId      String
  tokenHash      String       @unique
  status         ExportStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  parent         User         @relation(fields: [parentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  student        Student      @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([expiresAt, status])
}

enum ExportStatus {
  PENDING
  COMPLETED
  DOWNLOADED
  EXPIRED
}

model DataPurgeLog {
  id             String       @id @default(uuid())
  organizationId String
  purgedEntity   String
  purgedId       String
  purgedBy       String
  timestamp      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)

  @@index([organizationId, timestamp])
}

model Emergency {
  id              String             @id @default(uuid())
  organizationId  String
  tripId          String
  reporterId      String
  tripPingId      String?
  status          EmergencyStatus    @default(ACTIVE)
  category        EmergencyCategory
  description     String?
  priority        String             @default("HIGH")
  severity        EmergencySeverity  @default(HIGH)
  correlationId   String             @unique
  version         Int                @default(1)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  trip            Trip               @relation(fields: [tripId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization    Organization       @relation(fields: [organizationId], references: [organizationId], onDelete: Restrict)
  reporter        User               @relation("EmergencyReporter", fields: [reporterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  tripPing        TripPing?          @relation(fields: [tripPingId], references: [id], onDelete: SetNull)
  
  history         EmergencyHistory[]
  
  @@unique([tripId, status], name: "activeEmergencyPerTrip")
  @@index([organizationId, status])
}

model EmergencyHistory {
  id              String             @id @default(uuid())
  organizationId  String
  emergencyId     String
  actorId         String
  previousState   EmergencyStatus?
  newState        EmergencyStatus?
  eventType       String
  metadata        Json?
  timestamp       DateTime           @default(now())

  emergency       Emergency          @relation(fields: [emergencyId], references: [id], onDelete: Cascade)
  actor           User               @relation(fields: [actorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  
  @@index([emergencyId, timestamp])
}

enum EmergencyStatus {
  ACTIVE
  ACKNOWLEDGED
  RESPONDING
  RESOLVED
  CANCELLED
}

enum EmergencyCategory {
  SOS
  MEDICAL
  FIRE
  ACCIDENT
  BREAKDOWN
  SECURITY
  OTHER
}

enum EmergencySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
