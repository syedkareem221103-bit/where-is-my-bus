# Server configuration
PORT=4000
NODE_ENV=development

# Database configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/where_is_my_bus?schema=public"

# Security (JWT secrets and token expiry times)
ALLOW_DEV_EPHEMERAL_KEYS=true
# Or for production:
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----..."
JWT_ACCESS_EXPIRY="15m"   # 15 minutes
JWT_REFRESH_EXPIRY="7d"   # 7 days

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per IP in the window
